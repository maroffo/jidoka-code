+        helperExecutable,
+        containedIn: application,
+        maximumBytes: 128 * 1_048_576
+      )
+    )
+    let herdrHostSHA256 = sha256(
+      try readRegularFile(
+        runtimeConfiguration.herdrHostExecutable,
+        containedIn: runtimeConfiguration.herdrHostExecutable.deletingLastPathComponent(),
+        maximumBytes: 128 * 1_048_576
+      )
+    )
