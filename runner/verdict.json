{
  "type": "object",
  "properties": {
    "reviewed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Material unresolved questions that prevent a reliable verdict on a changed behavior."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "attribution": {
            "type": "string",
            "enum": [
              "introduced",
              "preexisting",
              "unknown"
            ]
          },
          "quote": {
            "type": "string"
          },
          "countercheck": {
            "type": "string"
          },
          "mergeability_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "How safe is merging this PR with this verified finding unresolved? 90 or above is ready to merge. Below 90 requires a fix before merging."
          }
        },
        "required": [
          "path",
          "line",
          "title",
          "impact",
          "evidence",
          "attribution",
          "quote",
          "countercheck",
          "mergeability_score"
        ],
        "additionalProperties": false
      }
    },
    "focus": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "checked": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "checked",
          "outcome",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Non-blocking scope and method notes."
    }
  },
  "required": [
    "reviewed_files",
    "limits",
    "findings",
    "focus",
    "notes"
  ],
  "additionalProperties": false
}
