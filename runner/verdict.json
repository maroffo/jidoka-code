{
  "type": "object",
  "properties": {
    "reviewed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Material unresolved questions that prevent a reliable verdict on a changed behavior."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "maxLength": 240,
            "minLength": 1,
            "description": "One short plain-language sentence naming who is affected and what breaks."
          },
          "evidence": {
            "type": "object",
            "properties": {
              "trigger": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "properties": {
                    "explanation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "explanation",
                    "path",
                    "line"
                  ],
                  "additionalProperties": false
                }
              },
              "test_gap": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "countercheck": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            },
            "required": [
              "trigger",
              "steps",
              "test_gap",
              "countercheck"
            ],
            "additionalProperties": false
          },
          "attribution": {
            "type": "string",
            "enum": [
              "introduced",
              "preexisting",
              "unknown"
            ]
          },
          "quote": {
            "type": "string"
          },
          "mergeability_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "How safe is merging this PR with this verified finding unresolved? 90 or above is ready to merge. Below 90 requires a fix before merging."
          }
        },
        "required": [
          "path",
          "line",
          "title",
          "impact",
          "evidence",
          "attribution",
          "quote",
          "mergeability_score"
        ],
        "additionalProperties": false
      }
    },
    "focus": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "checked": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "checked",
          "outcome",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Non-blocking scope and method notes."
    }
  },
  "required": [
    "reviewed_files",
    "limits",
    "findings",
    "focus",
    "notes"
  ],
  "additionalProperties": false
}
